# PRODUCTION. Values come from a secret manager, never from a file in git.
# Production REFUSES to start with a mock or sandbox provider unless ALLOW_NON_PROD_PROVIDER=true
# (a deliberate dry run: no real money moves). See GO_LIVE.md for the exact switch-over steps.
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info
DATABASE_URL=                      # postgres://...?sslmode=verify-full  (TLS is required)
JWT_SECRET=                        # openssl rand -base64 48
ENCRYPTION_KEY=                    # openssl rand -base64 32; keep the old key to read old data when rotating
ENCRYPTION_KEY_VERSION=1
PUBLIC_API_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
TRUST_PROXY=true                   # behind a TLS-terminating proxy / load balancer
CORS_ALLOWED_ORIGINS=              # https:// origins of any web client; empty for mobile only
SENDER_COUNTRIES=GB
PROVIDER_REDIRECT_HOSTS=           # hosts of the provider's hosted identity page
# --- Provider: live credentials (one of) -------------------------------------------------
PAYOUT_PROVIDER=wise
WISE_AUTH_MODE=oauth_partner
WISE_CLIENT_ID=
WISE_CLIENT_SECRET=
WISE_AUTHORIZE_URL=
WISE_OAUTH_REDIRECT_URI=
WISE_API_BASE_URL=https://api.wise.com        # or https://api-mtls.transferwise.com with PROVIDER_MTLS_*
WISE_ALLOW_PRODUCTION=true
WISE_WEBHOOK_PUBLIC_KEY=
# --- Limits (set deliberately for a limited launch) -------------------------------------------
TRANSFER_LIMIT_CURRENCY=GBP
TRANSFER_LIMIT_PER_TRANSFER=
TRANSFER_LIMIT_PER_DAY=
TRANSFER_LIMIT_PER_MONTH=
# --- Operations -------------------------------------------------------------------------------
SENTRY_DSN=
ADMIN_CONSOLE_ENABLED=true         # restrict /admin-console at the proxy (VPN or IP allow-list)
DASHBOARD_USD_RATES=GBP:1.27       # display only
MONTHLY_VOLUME_TARGET_USD=3000000
BACKGROUND_JOBS_ENABLED=false      # API processes; run `node dist/worker.js` separately
# --- Email (a real provider is required in production) ---------------------------
EMAIL_PROVIDER=                    # postmark | resend | ses  (log sends nothing)
EMAIL_FROM=
# POSTMARK_SERVER_TOKEN= / RESEND_API_KEY= / AWS_SES_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
RATE_LIMIT_STORE=postgres          # shared across instances
