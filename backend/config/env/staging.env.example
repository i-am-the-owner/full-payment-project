# STAGING. Production-like (NODE_ENV=production: HTTPS, HSTS, strict CORS, no dev tools) but with a
# SANDBOX or MOCK provider. Staging REFUSES to start with live provider credentials or hosts.
# Values come from your secret manager / platform environment, not from a file in git.
NODE_ENV=production
APP_ENV=staging
LOG_LEVEL=info
DATABASE_URL=                      # postgres://...?sslmode=require  (a separate staging database)
JWT_SECRET=                        # openssl rand -base64 48   (different from production)
ENCRYPTION_KEY=                    # openssl rand -base64 32   (different from production)
PUBLIC_API_URL=https://api.staging.example.com
PUBLIC_APP_URL=https://app.staging.example.com
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=
SENDER_COUNTRIES=GB
PAYOUT_PROVIDER=wise              # or airwallex; mock also works
WISE_AUTH_MODE=personal_token     # sandbox only
WISE_API_TOKEN=                   # SANDBOX token
WISE_API_BASE_URL=https://api.wise-sandbox.com
PROVIDER_REDIRECT_HOSTS=
SENTRY_DSN=                       # optional: Sentry project for staging
ADMIN_CONSOLE_ENABLED=true
# API processes: BACKGROUND_JOBS_ENABLED=false and run a separate worker (node dist/worker.js).
BACKGROUND_JOBS_ENABLED=false
# --- Email (a real provider is required in production) ---------------------------
EMAIL_PROVIDER=                    # postmark | resend | ses  (log sends nothing)
EMAIL_FROM=
# POSTMARK_SERVER_TOKEN= / RESEND_API_KEY= / AWS_SES_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
RATE_LIMIT_STORE=postgres          # shared across instances
