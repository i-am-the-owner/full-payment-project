# DEVELOPMENT. Copy to backend/.env. Mock provider by default; sandbox keys only if you test a real provider.
# No production keys, ever. (docker compose sets these for you; see ../../../docker-compose.yml.)
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://almapay:almapay@localhost:5432/almapay
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# openssl rand -base64 32
ENCRYPTION_KEY=
PAYOUT_PROVIDER=mock
DEV_LOG_MAIL_LINKS=true
ADMIN_CONSOLE_ENABLED=true
DASHBOARD_USD_RATES=GBP:1.27,EUR:1.08
