# ---------------------------------------------------------------------------
# AlmaPay backend – example environment configuration
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit a real `.env` file. NEVER put real secrets in this example file.
# Production and sandbox configuration is supplied by the deployment platform's
# secrets manager, not by committed files.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Structured log level: debug | info | warn | error
LOG_LEVEL=info

# Optional: overrides the version reported by the health endpoint.
# Defaults to the backend package.json version when unset.
# APP_VERSION=0.1.0

# --- Database (backend-only, never shipped in the mobile app) --------------
# Required. Local default matches the Docker service in docs/database/README.md.
DATABASE_URL=postgres://almapay:almapay@localhost:5432/almapay_dev
# DATABASE_POOL_MAX=10

# --- Authentication ------------------------------------------------------
# Required. HS256 signing secret for access tokens; min 32 chars, high entropy.
# The placeholder below is public: startup is refused if it is used with
# NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# JWT_ISSUER=almapay
# JWT_AUDIENCE=almapay-mobile
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_MIN_LENGTH=12
# ACCOUNT_LOCK_THRESHOLD=5
# ACCOUNT_LOCK_MINUTES=15
# Base URL the client uses for verification / reset links (not a secret):
# PUBLIC_APP_URL=https://app.almapay.example
# This backend's own public address. The payout provider sends customers back
# to <PUBLIC_API_URL>/api/v1/onboarding/callback after their identity check.
# Defaults to http://localhost:<PORT>; must be https in production. When testing
# on the Android emulator use http://10.0.2.2:<PORT> so the web view can reach it.
# PUBLIC_API_URL=http://localhost:3000
# Development only (PAYOUT_PROVIDER=mock): approve new customers at once, without the
# fake identity page. Refused in production.
# MOCK_SKIP_IDENTITY_CHECK=true
# Countries (ISO alpha-2, comma-separated) whose residents may sign up. Used
# only when the payout provider does not publish its own list.
# SENDER_COUNTRIES=GB

# --- Sending limits -----------------------------------------------------
# Per customer, as decimal amounts in TRANSFER_LIMIT_CURRENCY, counted on
# everything the customer pays (fee included). The day is a rolling 24 hours,
# the month a rolling 30 days. Transfers paid in another currency are refused.
# TRANSFER_LIMIT_CURRENCY=GBP
# TRANSFER_LIMIT_PER_TRANSFER=5000
# TRANSFER_LIMIT_PER_DAY=10000
# TRANSFER_LIMIT_PER_MONTH=25000

# --- HTTP hardening ---------------------------------------------------
# Set to true when running behind a trusted reverse proxy / load balancer.
# TRUST_PROXY=false
# Force HSTS regardless of NODE_ENV (default: on in production).
# HSTS_ENABLED=false

# --- Rate limiting --------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# --- Feature flags ----------------------------------------------------
# Fund transfers from AlmaPay's OWN provider balance. Keep this OFF: AlmaPay
# never holds or forwards customer money. With it off a transfer stays
# `awaiting_payment` until the customer pays the provider directly.
# ALMAPAY_BALANCE_FUNDING_ENABLED=false
# Local development only: write email verification / password reset links
# (which contain live tokens) to the log, because no mail service is wired up.
# Startup is refused if this is true with NODE_ENV=production.
# DEV_LOG_MAIL_LINKS=false

# --- Encryption of provider tokens at rest ---------------------------------
# Provider refresh tokens are encrypted by the app (AES-256-GCM) before they
# reach the database. Required in production; without it the app runs but
# refuses to store a token. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit a real key. Losing the key makes stored tokens unreadable.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_VERSION=1
# To rotate: move the current key here under its version, set a new
# ENCRYPTION_KEY and increase ENCRYPTION_KEY_VERSION. Old tokens stay readable
# and are re-encrypted with the new key the next time they are read.
# ENCRYPTION_PREVIOUS_KEYS=1:<base64>,2:<base64>

# --- Development seed data (npm run db:seed; mock provider only) -----------
# Optional password for the two seed customers. Leave unset to create them
# without a password (sign in through the password-reset flow instead).
# SEED_USER_PASSWORD=

# --- Payout provider ------------------------------------------------------
# Which licensed payout provider the backend talks to:
#   mock | wise | airwallex | currencycloud
# `mock` is the default, needs no other variable, and is refused in production.
# Startup fails with a clear message if the chosen provider's variables below
# are missing. BACKEND-ONLY: none of these may ever reach a client.
# PAYOUT_PROVIDER=mock
# PAYOUT_HTTP_TIMEOUT_MS=15000
# PAYOUT_HTTP_MAX_RETRIES=3

# --- Wise (PAYOUT_PROVIDER=wise) --------------------------------------------
# Sandbox by default. Never defaults to production. A production host is refused
# unless NODE_ENV=production, WISE_ALLOW_PRODUCTION=true and WISE_WEBHOOK_PUBLIC_KEY
# are all set, and a personal token is refused on any production host.
# See backend/README.md, "Wise setup".
# WISE_AUTH_MODE=personal_token          # personal_token (sandbox testing, one Wise account) | oauth_partner (UNTESTED)
# WISE_API_BASE_URL=https://api.wise-sandbox.com   # production: https://api.wise.com or https://api-mtls.transferwise.com
# WISE_API_VERSION=2026Q4                # dated API path version for the newer endpoints
#
# personal_token mode (now): a SANDBOX personal API token.
# WISE_API_TOKEN=
#
# oauth_partner mode (when Wise partner credentials arrive; untested):
# WISE_CLIENT_ID=
# WISE_CLIENT_SECRET=
# WISE_AUTHORIZE_URL=                    # https URL of Wise's authorise page, from your partner onboarding
# WISE_OAUTH_REDIRECT_URI=               # our callback, registered with Wise
#
# WISE_SOURCE_CURRENCIES=GBP             # currencies customers pay in (comma separated)
# WISE_WEBHOOK_PUBLIC_KEY=               # PEM; defaults to the bundled Wise sandbox key (sandbox hosts only; required for production)
# WISE_SCA_PRIVATE_KEY=                  # PEM; RSA private key for SCA one-time-token signing
# WISE_ALLOW_PRODUCTION=false
# Optional mTLS client certificate (PROVIDER_MTLS_*) is listed under the common provider settings below.

# --- Airwallex (PAYOUT_PROVIDER=airwallex) ---------------------------------
# Connected Accounts model: each customer has their own Airwallex account.
# Sandbox by default; production is refused unless NODE_ENV=production,
# AIRWALLEX_ALLOW_PRODUCTION=true and AIRWALLEX_WEBHOOK_SECRET are all set.
# AIRWALLEX_CLIENT_ID=                  # Airwallex web app > Developer > API keys
# AIRWALLEX_API_KEY=                    # shown once when the key is created
# AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# AIRWALLEX_WEBHOOK_SECRET=             # secret of the webhook notification URL
# AIRWALLEX_API_VERSION=2026-08-21
# AIRWALLEX_LEGAL_ENTITY_TYPE=INDIVIDUAL   # or BUSINESS (hosted onboarding is business only)
# AIRWALLEX_ACCOUNT_COUNTRY=GB
# AIRWALLEX_SOURCE_CURRENCIES=GBP
# AIRWALLEX_HOSTED_FLOW_TEMPLATE_ID=    # provided by Airwallex for hosted onboarding
# AIRWALLEX_ONBOARDING_RETURN_URL=
# AIRWALLEX_ONBOARDING_ERROR_URL=
# AIRWALLEX_ALLOW_PRODUCTION=false

# --- Currencycloud (PAYOUT_PROVIDER=currencycloud) – documented stub only ---
# CURRENCYCLOUD_API_BASE_URL=
# CURRENCYCLOUD_LOGIN_ID=
# CURRENCYCLOUD_API_KEY=

# --- Status updates -----------------------------------------------------
# Where customers are told to write for help (in transfer emails):
# SUPPORT_EMAIL=support@almapay.example
# The background worker (webhook processing, notifications, polling) starts with
# the server. Set false to run it in a separate process instead.
# BACKGROUND_JOBS_ENABLED=true
# JOBS_POLL_INTERVAL_MS=1000
# Safety-net poll: how often, and how long a transfer must be unchanged first:
# STUCK_TRANSFER_POLL_EVERY_MINUTES=15
# STUCK_TRANSFER_AFTER_MINUTES=30
# STUCK_TRANSFER_MAX_AGE_DAYS=30
# Development only: lets scripts/send-mock-webhook.ts sign test webhooks for a
# running server (random per process when unset):
# MOCK_WEBHOOK_SECRET=dev-only-secret-0123456789
# For `npm run webhooks:setup` (not read by the server):
# WEBHOOK_BASE_URL=https://api.almapay.example
# WISE_CLIENT_KEY=

# --- Security ------------------------------------------------------------
# Browser origins allowed to call this API (exact https origins, comma-separated;
# never *). Empty = no website may read responses. The mobile app is unaffected.
# CORS_ALLOWED_ORIGINS=https://app.almapay.example
# Hosts the provider's hosted identity page may be on (subdomains match). The
# customer's app is only ever sent to these. REQUIRED in production for any
# provider other than the mock.
# PROVIDER_REDIRECT_HOSTS=id.provider.example
# Alerts to an admin (never blocks): unusual activity in the last 24 hours.
# FRAUD_NEW_RECIPIENTS_PER_DAY_ALERT=5
# FRAUD_FAILED_TRANSFERS_PER_DAY_ALERT=3
# Mutual TLS to a provider that requires it (e.g. Wise's mTLS host). Paths only:
# the private key lives in a file with mode 600, never in git or this file.
# PROVIDER_MTLS_CERT_PATH=/run/secrets/almapay-client.pem
# PROVIDER_MTLS_KEY_PATH=/run/secrets/almapay-client.key
# PROVIDER_MTLS_CA_PATH=/run/secrets/provider-ca.pem
# Production also requires: DATABASE_URL with ?sslmode=require (or verify-full),
# TRUST_PROXY=true (TLS is terminated by a proxy), ENCRYPTION_KEY, a real
# JWT_SECRET and an https PUBLIC_API_URL. The server refuses to start otherwise.

# --- Deployment and operations ------------------------------------------------
# Which deployment this is: development | staging | production. Without it, NODE_ENV=production
# means production. Per-environment templates: backend/config/env/. See docs/operations/deployment.md.
# APP_ENV=development
# Production only: allow a mock or sandbox provider for a deliberate dry run (no real money moves).
# ALLOW_NON_PROD_PROVIDER=false
# Error tracking (Sentry-compatible DSN). Nothing is sent without it.
# SENTRY_DSN=
# Admin console page under /admin-console (the admin API is always protected by role + 2FA + audit).
# ADMIN_CONSOLE_ENABLED=true
# Display-only USD rates and the monthly volume target shown on the admin dashboard.
# DASHBOARD_USD_RATES=GBP:1.27,EUR:1.08
# MONTHLY_VOLUME_TARGET_USD=3000000
# The job worker (node dist/worker.js) serves its health check here.
# WORKER_HEALTH_PORT=3001

# --- Shared rate limits --------------------------------------------------------
# postgres (default): counted in the database, shared by every instance. memory: per process.
# RATE_LIMIT_STORE=postgres

# --- Customer limits (defaults shown; they must grow: per transfer <= per day <= per month) ---
# TRANSFER_LIMIT_CURRENCY=GBP
# TRANSFER_LIMIT_PER_TRANSFER=5000
# TRANSFER_LIMIT_PER_DAY=10000
# TRANSFER_LIMIT_PER_MONTH=25000

# --- Email ----------------------------------------------------------------------
# log (default) delivers nothing. Production refuses it unless ALLOW_NON_PROD_PROVIDER=true.
# EMAIL_PROVIDER=log                     # log | postmark | resend | ses
# EMAIL_FROM=AlmaPay <no-reply@almapay.example>   # a verified sender/domain (SPF, DKIM, DMARC)
# POSTMARK_SERVER_TOKEN=                 # EMAIL_PROVIDER=postmark
# RESEND_API_KEY=                        # EMAIL_PROVIDER=resend
# AWS_SES_REGION=eu-west-2               # EMAIL_PROVIDER=ses (use a role or least-privilege key: ses:SendEmail only)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
